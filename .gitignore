# Dependencies & Build Output
node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Backups & Execution Logs
backups/
logs/

# User Persistent Uploads Protection (Git NEVER tracks real uploaded media)
public/uploads/*
!public/uploads/audio/
public/uploads/audio/*
!public/uploads/audio/.gitkeep
!public/uploads/covers/
public/uploads/covers/*
!public/uploads/covers/.gitkeep

# Explicit media ignore inside uploads
public/uploads/**/*.mp3
public/uploads/**/*.wav
public/uploads/**/*.flac
public/uploads/**/*.aac
public/uploads/**/*.ogg
public/uploads/**/*.m4a
public/uploads/**/*.jpg
public/uploads/**/*.jpeg
public/uploads/**/*.png
public/uploads/**/*.webp
public/uploads/**/*.tmp
public/uploads/**/*.tar.gz
