APP_VERSION="1.0.0"
# ==========================================
# DODIK TRACKER - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# You can provide a full connection string:
DATABASE_URL="postgres://dodik_user:dodik_password@localhost:5432/dodik_tracker"

# Or individual connection parameters:
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="dodik_user"
SQL_PASSWORD="dodik_password"
SQL_DB_NAME="dodik_tracker"

# 2. APPLICATION & SECURITY
PORT=3000
APP_URL="http://localhost:3000"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
INTEGRATION_ENCRYPTION_KEY="dodik-master-secret-encryption-key-32b"

# 3. INITIAL ADMIN CONFIGURATION (Optional but recommended)
# When this username or email registers/logs in, they will automatically receive SUPER_ADMIN role.
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_EMAIL="admin@example.com"

# Set to "false" to prevent the first registered user from becoming SUPER_ADMIN if INITIAL_ADMIN_* is not set
ALLOW_FIRST_USER_ADMIN="true"

# 4. AI & EXTERNAL INTEGRATIONS (Optional)
# Gemini AI for intelligent descriptions, translations and recommendations
GEMINI_API_KEY=""

# Telegram Bot integration for notifications and passwordless login
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# 5. BACKUP & MAINTENANCE (Optional)
# Number of recent PostgreSQL database backups to retain (defaults to 10)
BACKUP_RETENTION_COUNT=10

